generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Same Supabase database as va-management, but this app only ever owns the
// `vaa_sys` Postgres schema. Listing it here (and nothing else) keeps every
// Prisma command scoped to it, so nothing in this project can diff, alter or
// drop va-management's tables in `public`.
//
// The links back to va-management (the signed-in staff member in
// public.users, the service list in public.departments) are read with raw
// SQL, never modelled here — a `public` model in this schema would let
// Prisma try to "fix" va-management's tables.
datasource db {
  provider = "postgresql"
  schemas  = ["vaa_sys"]
}

// ── Access ───────────────────────────────────────────────────────

// Who may use which part of vaa-sys. va-management's SUPER_ADMIN and
// SYSTEM_ADMIN accounts are admins without a row here; everyone else needs
// one (and an active va-management account). The roles are the legacy
// CMS's; what each may do lives in lib/permissions.ts.
enum AccessRole {
  ADMIN
  CS_MANAGER
  CUSTOMER_SPECIALIST
  LEAD_MANAGER
  SERVICE_MANAGER
  HR_SPECIALIST
  HR_MANAGER
  ACCOUNTING
  RECRUITMENT_SPECIALIST
  TRAINING_MANAGER
  EXECUTIVE
  EXECUTIVE_SUPPORT

  @@schema("vaa_sys")
}

model AccessUser {
  id           String     @id @default(cuid())
  email        String     @unique
  role         AccessRole
  // A Service Manager's department: a public.departments id (Workforce's
  // service departments), read with raw SQL. Unused for other roles.
  departmentId String?    @map("department_id")
  isActive     Boolean    @default(true) @map("is_active")
  addedByEmail String     @map("added_by_email")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("access_users")
  @@schema("vaa_sys")
}

// ── Settings ─────────────────────────────────────────────────────

// The legacy CMS "Settings" tab: short lookup lists an admin maintains.
// category is one of SETTING_CATEGORIES in lib/settings-fields.ts (text, so
// a later module can add a list without an enum migration). Departments and
// services are not here: they come from Workforce (public.departments and
// public.skills).
model SettingOption {
  id        String   @id @default(cuid())
  category  String
  value     String
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  // CountryRegion only: the IANA time zone, e.g. Asia/Jerusalem.
  timezone  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accountsByCategory      Account[]           @relation("AccountCategory")
  accountsByType          Account[]           @relation("AccountType")
  accountsByCountryRegion Account[]           @relation("AccountCountryRegion")
  customerStatusLogs      CustomerStatusLog[]
  accountStatusLogs       AccountStatusLog[]

  @@unique([category, value])
  @@index([category, sortOrder])
  @@map("setting_options")
  @@schema("vaa_sys")
}

// ── Activity log ─────────────────────────────────────────────────

// One generic audit trail for every module (legacy ActivityLogs). Written
// through logActivity() in lib/activity.ts, in the same transaction as the
// change. entityId is the record's id; customerId groups a row under its
// customer so a customer's page and a CS Specialist's scope can find it.
// No foreign keys: the log outlives what it describes.
model ActivityLog {
  id            String    @id @default(cuid())
  entityType    String    @map("entity_type")
  entityId      String    @map("entity_id")
  entityLabel   String?   @map("entity_label")
  customerId    String?   @map("customer_id")
  action        String
  field         String?
  oldValue      String?   @map("old_value")
  newValue      String?   @map("new_value")
  notes         String?
  actorEmail    String    @map("actor_email")
  actorName     String?   @map("actor_name")
  // When it took effect, if backdated; createdAt is when it was recorded.
  effectiveDate DateTime? @map("effective_date")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([actorEmail, createdAt])
  @@map("activity_logs")
  @@schema("vaa_sys")
}

// ── Customers ────────────────────────────────────────────────────

// The legacy Apps Script CMS's six statuses.
enum CustomerStatus {
  PENDING
  ACTIVE
  PAUSED
  INACTIVE
  CANCELLED
  TERMINATED

  @@schema("vaa_sys")
}

// Where a lead is in Lead Management's workflow (lib/lead-phase.ts). Worked
// out from the facts on the customer, never picked by hand.
enum LeadPhase {
  CUSTOMER_INTAKE
  CONTRACT_BILLING_INITIATION
  CONTRACT_PAYMENT_CONFIRMATION
  CUSTOMER_SUCCESS_HANDOFF
  NEW_CUSTOMER_ONBOARDED

  @@schema("vaa_sys")
}

// A Special Request (the customer meets the VA first, approved by the CEO)
// goes to Customer Success Handoff before the contract and payment are
// confirmed.
enum LeadRequestType {
  REGULAR
  SPECIAL

  @@schema("vaa_sys")
}

// A lead is a customer that hasn't finished onboarding yet: Lead Management
// creates the row (status PENDING) and Customer Management takes it from
// there. customerCode keeps the legacy CMS format (CUST_ + 12 hex).
model Customer {
  id                      String          @id @default(cuid())
  customerCode            String          @unique @map("customer_code")
  name                    String
  email                   String?
  status                  CustomerStatus  @default(PENDING)
  // When the current status took effect (backdated if the change was).
  statusChangedAt         DateTime        @default(now()) @map("status_changed_at")
  notes                   String?
  // The CS Specialist who owns this customer, by work email (lowercase).
  assignedSpecialistEmail String?         @map("assigned_specialist_email")
  // First payment: a date, or "no payment yet".
  paymentDate             DateTime?       @map("payment_date") @db.Date
  noPaymentYet            Boolean         @default(true) @map("no_payment_yet")
  terminationCount        Int             @default(0) @map("termination_count")
  reactivationCount       Int             @default(0) @map("reactivation_count")
  // Pending review: a Pause/Terminate/Cancel by anyone but a CS Manager or
  // admin applies at once and is flagged here until a CS Manager confirms
  // it or cancels it (which puts statusBeforeReview back).
  reviewAction            CustomerStatus? @map("review_action")
  statusBeforeReview      CustomerStatus? @map("status_before_review")
  reviewRequestedByEmail  String?         @map("review_requested_by_email")
  reviewRequestedAt       DateTime?       @map("review_requested_at")
  reviewReason            String?         @map("review_reason")
  createdById             String?         @map("created_by_id")
  createdByEmail          String          @map("created_by_email")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")
  // A test lead an admin made to try the workflow (lib/test-leads.ts). It is
  // listed with a Test badge but left out of reports and counts, and only
  // test leads can be deleted.
  isTest                  Boolean         @default(false) @map("is_test")

  // Lead workflow (lib/lead-phase.ts). leadPhase is a cache of the phase the
  // facts below (and the onboarding form) add up to; every change of it is
  // in lead_phase_logs.
  leadPhase                LeadPhase       @default(CUSTOMER_INTAKE) @map("lead_phase")
  leadPhaseChangedAt       DateTime        @default(now()) @map("lead_phase_changed_at")
  requestType              LeadRequestType @default(REGULAR) @map("request_type")
  // Customer Intake done without the onboarding form: leads imported from
  // the Leads template (lib/lead-import.ts) at a later phase.
  intakeCompletedAt        DateTime?       @map("intake_completed_at")
  // The contract picked for a lead that has no account yet (imported
  // leads). A lead from the form uses its account's contract instead.
  contractId               String?         @map("contract_id")
  contract                 Contract?       @relation("LeadContract", fields: [contractId], references: [id], onDelete: SetNull)
  // The contract email sent to the lead, and which contract it was for.
  contractSentAt           DateTime?       @map("contract_sent_at")
  contractSentByEmail      String?         @map("contract_sent_by_email")
  contractSentId           String?         @map("contract_sent_id")
  contractSent             Contract?       @relation("ContractSent", fields: [contractSentId], references: [id], onDelete: SetNull)
  // Contract & Payment Confirmation: the signed contract and the first
  // payment (paymentDate above) confirmed.
  contractSignedOn         DateTime?       @map("contract_signed_on") @db.Date
  contractConfirmedAt      DateTime?       @map("contract_confirmed_at")
  contractConfirmedByEmail String?         @map("contract_confirmed_by_email")
  // Customer Success Handoff: the CS team onboarded the customer officially.
  handoffCompletedAt       DateTime?       @map("handoff_completed_at")
  handoffCompletedByEmail  String?         @map("handoff_completed_by_email")

  statusLogs      CustomerStatusLog[]
  phaseLogs       LeadPhaseLog[]
  onboardingLinks OnboardingLink[]
  submissions     OnboardingSubmission[]
  accounts        Account[]
  tickets         Ticket[]
  takeovers       CustomerTakeover[]
  notesLog        CustomerAccountNote[]
  invoices        Invoice[]
  payments        Payment[]
  vaConnections   VaConnection[]

  @@index([name])
  @@index([status])
  @@index([assignedSpecialistEmail])
  @@index([leadPhase])
  @@map("customers")
  @@schema("vaa_sys")
}

// Every change of a lead's phase, including the first move out of Customer
// Intake (fromPhase is never null: every lead starts in Customer Intake).
model LeadPhaseLog {
  id             String    @id @default(cuid())
  customerId     String    @map("customer_id")
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromPhase      LeadPhase @map("from_phase")
  toPhase        LeadPhase @map("to_phase")
  // What moved it, e.g. "Contract sent", "Switched to Special Request".
  note           String?
  changedByEmail String    @map("changed_by_email")
  changedAt      DateTime  @default(now()) @map("changed_at")

  @@index([customerId, changedAt])
  @@map("lead_phase_logs")
  @@schema("vaa_sys")
}

// Every status change, including the first one (fromStatus null = created).
model CustomerStatusLog {
  id                  String          @id @default(cuid())
  customerId          String          @map("customer_id")
  customer            Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromStatus          CustomerStatus? @map("from_status")
  toStatus            CustomerStatus  @map("to_status")
  reason              String?
  // Terminated/Cancelled: the reason from Settings (TerminationReason).
  terminationReasonId String?         @map("termination_reason_id")
  terminationReason   SettingOption?  @relation(fields: [terminationReasonId], references: [id], onDelete: SetNull)
  // When it took effect, if the person backdated it; changedAt is when it
  // was recorded.
  effectiveDate       DateTime?       @map("effective_date")
  changedById         String?         @map("changed_by_id")
  changedByEmail      String          @map("changed_by_email")
  changedAt           DateTime        @default(now()) @map("changed_at")

  @@index([customerId, changedAt])
  @@map("customer_status_logs")
  @@schema("vaa_sys")
}

// A CS Specialist covering specific customers for someone else between two
// dates (legacy CustomerTakeovers, which replaced the "backup specialist").
// Active while startDate <= today <= endDate (Manila) and not cancelled.
model CustomerTakeover {
  id               String    @id @default(cuid())
  customerId       String    @map("customer_id")
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  specialistEmail  String    @map("specialist_email")
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime  @map("end_date") @db.Date
  reason           String?
  createdByEmail   String    @map("created_by_email")
  createdAt        DateTime  @default(now()) @map("created_at")
  cancelledAt      DateTime? @map("cancelled_at")
  cancelledByEmail String?   @map("cancelled_by_email")

  @@index([specialistEmail, startDate, endDate])
  @@index([customerId])
  @@map("customer_takeovers")
  @@schema("vaa_sys")
}

// Notes on a customer, or on one of its accounts (accountId set). An
// account's page shows its own notes and its customer's.
model CustomerAccountNote {
  id             String   @id @default(cuid())
  customerId     String   @map("customer_id")
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accountId      String?  @map("account_id")
  account        Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  body           String
  createdByEmail String   @map("created_by_email")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([customerId, createdAt])
  @@index([accountId, createdAt])
  @@map("customer_account_notes")
  @@schema("vaa_sys")
}

// ── Onboarding ───────────────────────────────────────────────────

// The prefilled link Lead Management sends to a customer. The token is the
// only thing that grants access to the public form, so it is random and
// single-purpose; a new link revokes the customer's older open ones.
model OnboardingLink {
  id             String    @id @default(cuid())
  customerId     String    @map("customer_id")
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token          String    @unique
  createdByEmail String    @map("created_by_email")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  openedAt       DateTime? @map("opened_at")
  submittedAt    DateTime? @map("submitted_at")

  submission OnboardingSubmission?

  @@index([customerId])
  @@map("onboarding_links")
  @@schema("vaa_sys")
}

// Exactly what the customer submitted, kept as-is for reference. The usable
// records made from it are the Account (Part 1) and the Ticket with its
// requests (Part 2).
model OnboardingSubmission {
  id               String         @id @default(cuid())
  linkId           String         @unique @map("link_id")
  link             OnboardingLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  customerId       String         @map("customer_id")
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accountId        String?        @unique @map("account_id")
  account          Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  part1            Json           @map("part_1")
  part2            Json           @map("part_2")
  // Part 3 (VA personality preference) is optional and can come later on
  // the same link; null until the customer fills it in.
  part3            Json?          @map("part_3")
  part3SubmittedAt DateTime?      @map("part_3_submitted_at")
  submittedAt      DateTime       @default(now()) @map("submitted_at")

  ticket Ticket?

  @@index([customerId])
  @@map("onboarding_submissions")
  @@schema("vaa_sys")
}

// ── Accounts ─────────────────────────────────────────────────────

enum ContactKind {
  PRIMARY
  SECONDARY

  @@schema("vaa_sys")
}

// Who invoices go to: one of the account's contacts, or someone else.
enum InvoiceContactSource {
  PRIMARY
  SECONDARY
  OTHER

  @@schema("vaa_sys")
}

// What the customer pays with. NIS bank transfer is offered to Israel only.
enum PaymentMethod {
  NIS_BANK_TRANSFER
  PAYONEER
  WISE
  CREDIT_CARD
  ACH_TRANSFER
  SWIFT_TRANSFER
  OTHER

  @@schema("vaa_sys")
}

// An account under a customer, made from Part 1 of the onboarding form. The
// first account is usually named after the customer. accountCode keeps the
// legacy CMS format (CLT_ + 12 hex), like the CMS "Clients" tab.
model Account {
  id                     String               @id @default(cuid())
  accountCode            String               @unique @map("account_code")
  customerId             String               @map("customer_id")
  customer               Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name                   String
  companyName            String               @map("company_name")
  dbaName                String?              @map("dba_name")
  website                String?
  timeZone               String?              @map("time_zone")
  invoiceContactSource   InvoiceContactSource @map("invoice_contact_source")
  invoiceContactName     String?              @map("invoice_contact_name")
  invoiceContactEmail    String               @map("invoice_contact_email")
  paymentMethod          PaymentMethod        @map("payment_method")
  billingCountry         String?              @map("billing_country")
  paymentMethodOther     String?              @map("payment_method_other")
  hasPayoneerOrWise      Boolean?             @map("has_payoneer_or_wise")
  invoiceContactRole     String?              @map("invoice_contact_role")
  businessAddress        String?              @map("business_address")
  // The platforms the VAs will work on, for the whole account.
  platforms              String[]             @default([])
  platformOther          String?              @map("platform_other")
  // Unused: in the Google Form, FBA/FBM and seller type are free text in
  // otherInfo. Kept to match 004; a later SQL file can drop them.
  fulfillmentType        String?              @map("fulfillment_type")
  sellerType             String?              @map("seller_type")
  otherInfo              String?              @map("other_info")
  // Customer Management fields (legacy Accounts tab).
  status                 AccountStatus        @default(PENDING)
  statusChangedAt        DateTime             @default(now()) @map("status_changed_at")
  // Came back after being terminated, or matches a terminated account's
  // company. A flag, not a status.
  isReturning            Boolean              @default(false) @map("is_returning")
  categoryId             String?              @map("category_id")
  category               SettingOption?       @relation("AccountCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  typeId                 String?              @map("type_id")
  type                   SettingOption?       @relation("AccountType", fields: [typeId], references: [id], onDelete: SetNull)
  countryRegionId        String?              @map("country_region_id")
  countryRegion          SettingOption?       @relation("AccountCountryRegion", fields: [countryRegionId], references: [id], onDelete: SetNull)
  sellerOnboardingLink   String?              @map("seller_onboarding_link")
  // The signed contract document; contractId is which contract terms apply.
  contractLink           String?              @map("contract_link")
  contractId             String?              @map("contract_id")
  contract               Contract?            @relation(fields: [contractId], references: [id], onDelete: SetNull)
  // Pending review, as on Customer. reviewFromCustomer: flagged because
  // its customer was paused/terminated, so it follows the customer's review.
  reviewAction           AccountStatus?       @map("review_action")
  statusBeforeReview     AccountStatus?       @map("status_before_review")
  reviewRequestedByEmail String?              @map("review_requested_by_email")
  reviewRequestedAt      DateTime?            @map("review_requested_at")
  reviewReason           String?              @map("review_reason")
  reviewFromCustomer     Boolean              @default(false) @map("review_from_customer")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  contacts   AccountContact[]
  tickets    Ticket[]
  submission OnboardingSubmission?
  managers   AccountManager[]
  statusLogs AccountStatusLog[]
  notes      CustomerAccountNote[]
  invoices   Invoice[]
  vaConnections VaConnection[]

  @@index([customerId])
  @@index([status])
  @@map("accounts")
  @@schema("vaa_sys")
}

// Legacy account statuses. PENDING is never picked by hand: new accounts
// start there and reactivated ones go back to it, and both become ACTIVE
// when a VA connection starts (lib/va-connection-hooks.ts).
enum AccountStatus {
  PENDING
  ACTIVE
  PAUSED
  INACTIVE
  TERMINATED
  CANCELLED

  @@schema("vaa_sys")
}

// Every account status change (fromStatus null = created).
model AccountStatusLog {
  id                  String         @id @default(cuid())
  accountId           String         @map("account_id")
  account             Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fromStatus          AccountStatus? @map("from_status")
  toStatus            AccountStatus  @map("to_status")
  reason              String?
  terminationReasonId String?        @map("termination_reason_id")
  terminationReason   SettingOption? @relation(fields: [terminationReasonId], references: [id], onDelete: SetNull)
  effectiveDate       DateTime?      @map("effective_date")
  changedByEmail      String         @map("changed_by_email")
  changedAt           DateTime       @default(now()) @map("changed_at")

  @@index([accountId, changedAt])
  @@map("account_status_logs")
  @@schema("vaa_sys")
}

// The account's account managers on the customer's side: one row per
// person (the legacy CMS kept two comma lists that drifted apart).
model AccountManager {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([accountId])
  @@map("account_managers")
  @@schema("vaa_sys")
}

// ── Contracts ────────────────────────────────────────────────────

// How a contract section's value is entered and shown.
enum ContractFieldType {
  PERCENTAGE
  AMOUNT
  TEXT
  YES_NO

  @@schema("vaa_sys")
}

// A contract template (legacy Contracts, CON-001). Accounts point at the
// one that applies (Account.contractId), the single source of truth.
model Contract {
  id             String   @id @default(cuid())
  contractCode   String   @unique @map("contract_code")
  name           String
  description    String?
  // Review period: Annual, Semi-Annual, Quarterly, Monthly, Not Updated.
  period         String   @default("Annual")
  isActive       Boolean  @default(true) @map("is_active")
  notes          String?
  // The template sent to leads: a Google Drive / Docs link.
  templateUrl    String?  @map("template_url")
  createdByEmail String   @map("created_by_email")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedByEmail String?  @map("updated_by_email")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sections ContractSection[]
  accounts Account[]
  // MODULE 2: some older VA connections follow a contract other than their
  // account's. Add contract_id to va_connections (null = the account's)
  // when that table exists.
  sentToCustomers Customer[] @relation("ContractSent")
  leads           Customer[] @relation("LeadContract")
  services        ServiceProfile[]

  @@map("contracts")
  @@schema("vaa_sys")
}

// The sections every contract can fill in (e.g. "Late fee", Percentage).
model ContractSectionDef {
  id             String            @id @default(cuid())
  name           String
  fieldType      ContractFieldType @default(TEXT) @map("field_type")
  description    String?
  sortOrder      Int               @default(0) @map("sort_order")
  isActive       Boolean           @default(true) @map("is_active")
  createdByEmail String            @map("created_by_email")
  createdAt      DateTime          @default(now()) @map("created_at")

  values ContractSection[]

  @@map("contract_section_defs")
  @@schema("vaa_sys")
}

// One contract's value for one section. YES_NO is stored as "Yes"/"No".
model ContractSection {
  id             String             @id @default(cuid())
  contractId     String             @map("contract_id")
  contract       Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sectionDefId   String             @map("section_def_id")
  sectionDef     ContractSectionDef @relation(fields: [sectionDefId], references: [id], onDelete: Cascade)
  value          String
  updatedByEmail String             @map("updated_by_email")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@unique([contractId, sectionDefId])
  @@map("contract_sections")
  @@schema("vaa_sys")
}

// The account's primary and (optional) secondary contact. Exactly one
// contact per account is the focal person, the one VAA works with day to day.
model AccountContact {
  id        String      @id @default(cuid())
  accountId String      @map("account_id")
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      ContactKind
  firstName String      @map("first_name")
  lastName  String      @map("last_name")
  role      String?
  email     String
  whatsapp  String?
  region    String?
  isFocal   Boolean     @default(false) @map("is_focal")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@unique([accountId, kind])
  @@map("account_contacts")
  @@schema("vaa_sys")
}

// ── Tickets ──────────────────────────────────────────────────────

// Hiring group for a VA request. Regular unless Lead Management changes it.
enum RequestGroup {
  REGULAR
  EXPERT
  CASUAL

  @@schema("vaa_sys")
}

// Weekly flexible: a number of hours a week, any time. Daily flexible: hours
// a day, any time. Daily fixed: set start and end times (Philippine time),
// which can fall in the night-differential window. Project: a total number
// of hours.
enum ScheduleType {
  WEEKLY_FLEXIBLE
  DAILY_FLEXIBLE
  DAILY_FIXED
  PROJECT
  MONTHLY

  @@schema("vaa_sys")
}

// Main ticket: one per account request, shown as TKT-000001. Each VA
// request in it is a sub-ticket (TicketRequest), shown as TKT-000001-01.
model Ticket {
  id             String                @id @default(cuid())
  ticketNumber   Int                   @unique @default(autoincrement()) @map("ticket_number")
  customerId     String                @map("customer_id")
  customer       Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accountId      String                @map("account_id")
  account        Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  submissionId   String?               @unique @map("submission_id")
  submission     OnboardingSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  createdByEmail String                @map("created_by_email")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  // Service Requests (Customer Management, Nov 5, 2026; lib/service-requests.ts).
  // The onboarding form's ticket is the account's New one.
  type                   ServiceRequestType  @default(NEW)
  // A cache of the phase its candidates add up to (the most advanced one).
  // New tickets start in VA Assignment (Nov 6, 2026); NEW is older data.
  phase                  ServiceRequestPhase @default(VA_ASSIGNMENT)
  phaseChangedAt         DateTime            @default(now()) @map("phase_changed_at")
  // The Service Department Manager the customer's CS assigned it to, and
  // their department (a public.departments id, read with raw SQL). Older
  // tickets only: since Nov 6, 2026 each VA request has its own department
  // (ticket_requests.department_id) and any of its managers acts.
  managerEmail           String?             @map("manager_email")
  departmentId           String?             @map("department_id")
  managerAssignedAt      DateTime?           @map("manager_assigned_at")
  managerAssignedByEmail String?             @map("manager_assigned_by_email")
  closedAt               DateTime?           @map("closed_at")
  closedByEmail          String?             @map("closed_by_email")
  closedReason           String?             @map("closed_reason")
  // The customer's focal person for this request (Nov 6, 2026), when it
  // isn't the account's focal contact. Set by the ticket import.
  focalName              String?             @map("focal_name")
  focalEmail             String?             @map("focal_email")
  focalPhone             String?             @map("focal_phone")
  focalRole              String?             @map("focal_role")

  requests        TicketRequest[]
  candidates      ServiceRequestCandidate[]
  connections     VaConnection[]
  scheduleChanges ScheduleChange[]
  rateAgreements  RateAgreement[]

  @@index([customerId])
  @@index([accountId])
  @@index([phase])
  @@index([managerEmail])
  @@map("tickets")
  @@schema("vaa_sys")
}

enum ServiceRequestType {
  NEW
  ADDITIONAL
  REPLACEMENT
  RELIEVER

  @@schema("vaa_sys")
}

enum ServiceRequestPhase {
  NEW
  VA_ASSIGNMENT
  VA_PREPARATION
  RATE_AGREEMENT
  KICKOFF_CALL
  CONNECTION_CALL
  START_VA
  CLOSED_WON
  CLOSED_LOST

  @@schema("vaa_sys")
}

// Where one VA candidate is. A ticket's phase is its most advanced active
// candidate's stage (lib/service-request-fields.ts).
enum CandidateStage {
  VA_PREPARATION
  RATE_AGREEMENT
  KICKOFF_CALL
  CONNECTION_CALL
  START_VA
  STARTED
  DECLINED
  WITHDRAWN

  @@schema("vaa_sys")
}

enum CandidateRole {
  MAIN
  BUFFER

  @@schema("vaa_sys")
}

// A VA the Service Department Manager put forward for one VA request
// (sub-ticket): the main VA or a buffer. vaProfileId is VA Workforce's
// public.va_profiles id (read with raw SQL); the name and email are kept as
// they were when assigned.
model ServiceRequestCandidate {
  id                   String         @id @default(cuid())
  ticketId             String         @map("ticket_id")
  ticket               Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  requestId            String         @map("request_id")
  request              TicketRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vaProfileId          String         @map("va_profile_id")
  vaName               String         @map("va_name")
  vaEmail              String?        @map("va_email")
  role                 CandidateRole  @default(MAIN)
  stage                CandidateStage @default(VA_PREPARATION)
  stageChangedAt       DateTime       @default(now()) @map("stage_changed_at")
  assignedByEmail      String         @map("assigned_by_email")
  assignedAt           DateTime       @default(now()) @map("assigned_at")
  prepDoneAt           DateTime?      @map("prep_done_at")
  prepDoneByEmail      String?        @map("prep_done_by_email")
  rateConfirmedAt      DateTime?      @map("rate_confirmed_at")
  rateConfirmedByEmail String?        @map("rate_confirmed_by_email")
  kickoffAt            DateTime?      @map("kickoff_at")
  kickoffByEmail       String?        @map("kickoff_by_email")
  outcomeAt            DateTime?      @map("outcome_at")
  outcomeByEmail       String?        @map("outcome_by_email")
  declineReason        String?        @map("decline_reason")
  startDate            DateTime?      @map("start_date") @db.Date
  startedByEmail       String?        @map("started_by_email")
  notes                String?
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  connection    VaConnection?
  rateAgreement RateAgreement?

  @@unique([requestId, vaProfileId])
  @@index([ticketId])
  @@map("service_request_candidates")
  @@schema("vaa_sys")
}

enum VaConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  STARTED
  PAUSED
  CANCELLED
  TERMINATED
  UNKNOWN

  @@schema("vaa_sys")
}

// A VA working for an account (legacy VAConnections). Made when the Service
// Department Manager marks a candidate Started; the legacy CMS's connections
// are imported (scripts/import-legacy-customers.ts) with their VA's legacy
// id and name, since those don't match VA Workforce's profiles.
model VaConnection {
  id              String                   @id @default(cuid())
  connectionCode  String                   @unique @map("connection_code")
  customerId      String                   @map("customer_id")
  customer        Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accountId       String                   @map("account_id")
  account         Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticketId        String?                  @map("ticket_id")
  ticket          Ticket?                  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  candidateId     String?                  @unique @map("candidate_id")
  candidate       ServiceRequestCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  vaProfileId     String?                  @map("va_profile_id")
  vaExternalId    String?                  @map("va_external_id")
  vaName          String                   @map("va_name")
  status          VaConnectionStatus
  statusChangedAt DateTime                 @default(now()) @map("status_changed_at")
  connectionType  String?                  @map("connection_type")
  service         String?
  department      String?
  hours           String?
  hoursType       String?                  @map("hours_type")
  connectionDate  DateTime?                @map("connection_date") @db.Date
  startDate       DateTime?                @map("start_date") @db.Date
  endDate         DateTime?                @map("end_date") @db.Date
  notes           String?
  // APP (made here) or LEGACY (imported from the legacy CMS).
  source          String                   @default("APP")
  createdByEmail  String                   @map("created_by_email")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@index([customerId, status])
  @@index([accountId, status])
  @@index([status])
  @@map("va_connections")
  @@schema("vaa_sys")
}

model TicketRequest {
  id                    String       @id @default(cuid())
  ticketId              String       @map("ticket_id")
  ticket                Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  lineNo                Int          @map("line_no")
  // Older requests only; the platform now lives on the account.
  platform              String?
  service               String
  numberOfVas           Int          @map("number_of_vas")
  scheduleType          ScheduleType @map("schedule_type")
  hoursPerWeek          Decimal?     @map("hours_per_week") @db.Decimal(5, 2)
  hoursPerDay           Decimal?     @map("hours_per_day") @db.Decimal(4, 2)
  startTimePht          String?      @map("start_time_pht")
  endTimePht            String?      @map("end_time_pht")
  workDays              String[]     @map("work_days")
  nightDifferential     Boolean      @default(false) @map("night_differential")
  projectHours          Decimal?     @map("project_hours") @db.Decimal(6, 2)
  hoursPerMonth         Decimal?     @map("hours_per_month") @db.Decimal(6, 2)
  // "Will the VA be working with a task tracker?"
  taskTracker           Boolean?     @map("task_tracker")
  // Free text, e.g. "1H Sat or Sun". additionalHoursPerDay is older requests only.
  additionalHours       String?      @map("additional_hours")
  additionalHoursPerDay Decimal?     @map("additional_hours_per_day") @db.Decimal(4, 2)
  targetStartDate       DateTime     @map("target_start_date") @db.Date
  tasks                 String
  tools                 String?
  requestGroup          RequestGroup @default(REGULAR) @map("request_group")
  requestGroupSetBy     String?      @map("request_group_set_by")
  // Daily schedules (Nov 6, 2026): hours for each day, {"Mon": 8, ..., "Sun": 0}.
  // workDays are the days above 0. Null on older requests: hoursPerDay on workDays.
  dayHours              Json?        @map("day_hours")
  // The client's time zone for this request; null = the account's.
  timeZone              String?      @map("time_zone")
  // "Must-haves or deal breakers" from the onboarding form.
  mustHaves             String?      @map("must_haves")
  // The Workforce service department this VA comes from (public.departments
  // id), worked out from the service and changeable by the CS. Its active
  // Service Managers act on the request (lib/request-departments.ts).
  departmentId          String?      @map("department_id")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  invoiceItems    InvoiceItem[]
  candidates      ServiceRequestCandidate[]
  scheduleChanges ScheduleChange[]
  rateAgreements  RateAgreement[]

  @@unique([ticketId, lineNo])
  @@map("ticket_requests")
  @@schema("vaa_sys")
}

// Every change to a VA request's schedule (Nov 6, 2026; lib/request-schedule.ts),
// kept for good so a connected VA's schedule can be followed. A change while
// the service request is still open affects the initial bill: it needs
// Executive Support's check (needsReview until reviewedAt), and the VA can't
// be marked started until then.
model ScheduleChange {
  id              String        @id @default(cuid())
  ticketId        String        @map("ticket_id")
  ticket          Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  requestId       String        @map("request_id")
  request         TicketRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedAt       DateTime      @default(now()) @map("changed_at")
  changedByEmail  String        @map("changed_by_email")
  // SCHEDULE, or SERVICE (Nov 6, 2026): the request's service and department
  // changed. A service change on an open New ticket needs the same check.
  kind            String        @default("SCHEDULE")
  // The schedule fields before and after (lib/request-schedule.ts ScheduleSnapshot),
  // or for SERVICE the service and department (ServiceSnapshot).
  before          Json
  after           Json
  // The ticket's phase when it changed.
  phase           String
  needsReview     Boolean       @default(false) @map("needs_review")
  reviewedAt      DateTime?     @map("reviewed_at")
  reviewedByEmail String?       @map("reviewed_by_email")
  reviewNote      String?       @map("review_note")

  @@index([ticketId])
  @@index([requestId])
  @@index([needsReview, reviewedAt])
  @@map("schedule_changes")
  @@schema("vaa_sys")
}

// Where a Rate Agreement is (Nov 6, 2026). HR walks it through these in
// order; at VA_ACKNOWLEDGED the VA moves on to the Kick-off Call.
enum RateAgreementStatus {
  WAITING
  PREPARED
  SCHEDULE_CONFIRMED
  PAYROLL_ACKNOWLEDGED
  SENT_TO_VA
  VA_ACKNOWLEDGED
  CANCELLED

  @@schema("vaa_sys")
}

enum RateAgreementBond {
  NONE
  TRAINING
  PERFORMANCE
  BOTH

  @@schema("vaa_sys")
}

// One VA's Rate Agreement on a service request (lib/rate-agreements.ts),
// made when the Service Department Manager moves the VA to Rate Agreement.
// An HR Manager assigns it to an HR Specialist, who fills in the terms
// (bonds, night differential, incremental wage increase: the contract's to
// start with) and records each step. It's cancelled with its ticket or VA.
// The rate itself isn't stored here: it's the service's confidential VA
// Base Rate (lib/rates.ts), shown only to rate viewers.
model RateAgreement {
  id                       String                  @id @default(cuid())
  ticketId                 String                  @map("ticket_id")
  ticket                   Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  requestId                String                  @map("request_id")
  request                  TicketRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  candidateId              String                  @unique @map("candidate_id")
  candidate                ServiceRequestCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status                   RateAgreementStatus     @default(WAITING)
  statusChangedAt          DateTime                @default(now()) @map("status_changed_at")
  assignedToEmail          String?                 @map("assigned_to_email")
  assignedByEmail          String?                 @map("assigned_by_email")
  assignedAt               DateTime?               @map("assigned_at")
  // Null until HR sets them; the page starts from the account's contract.
  bond                     RateAgreementBond?
  nightDifferential        Boolean?                @map("night_differential")
  incrementalWage          Boolean?                @map("incremental_wage")
  notes                    String?
  preparedAt               DateTime?               @map("prepared_at")
  preparedByEmail          String?                 @map("prepared_by_email")
  scheduleConfirmedAt      DateTime?               @map("schedule_confirmed_at")
  scheduleConfirmedByEmail String?                 @map("schedule_confirmed_by_email")
  payrollAckAt             DateTime?               @map("payroll_ack_at")
  payrollAckByEmail        String?                 @map("payroll_ack_by_email")
  // The day the Rate Agreement was sent to the VA, as HR enters it.
  sentOn                   DateTime?               @map("sent_on") @db.Date
  sentByEmail              String?                 @map("sent_by_email")
  vaAckAt                  DateTime?               @map("va_ack_at")
  vaAckByEmail             String?                 @map("va_ack_by_email")
  cancelledAt              DateTime?               @map("cancelled_at")
  cancelledReason          String?                 @map("cancelled_reason")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  @@index([ticketId])
  @@index([status])
  @@index([assignedToEmail])
  @@map("rate_agreements")
  @@schema("vaa_sys")
}

// ── Accounting ───────────────────────────────────────────────────

// The Accounting System (app/(acct)/): every bill and payment. Only the
// initial bill exists so far; the monthly bills (legacy BillingCycles) are a
// later kind. How a bill is worked out is lib/billing-fields.ts, from the
// "Initial Billing Process — Summary & Guide" doc.
enum InvoiceKind {
  INITIAL

  @@schema("vaa_sys")
}

// DRAFT: being prepared, can change. SENT onwards the lines are frozen;
// PARTIALLY_PAID and PAID follow the payments recorded against it. VOID: sent
// by mistake or replaced, kept for the record.
enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID

  @@schema("vaa_sys")
}

// The currency on the client's record. Amounts are entered in it; nothing is
// converted.
enum BillingCurrency {
  USD
  GBP
  NIS

  @@schema("vaa_sys")
}

enum InvoiceLineKind {
  OTF
  OTF_DISCOUNT
  DEPOSIT
  DEPOSIT_DISCOUNT
  SERVICE_FEE
  ND_FEE
  FREE_HOURS

  @@schema("vaa_sys")
}

// Why part of a standard amount wasn't billed (Foregone Revenue).
enum ForegoneType {
  WAIVED
  DISCOUNTED
  FREE

  @@schema("vaa_sys")
}

// A bill to a customer, shown as INV-0001. The fee settings it was worked out
// with are copied onto it, so changing the defaults later never changes a bill
// already made. subtotal/vat/paypal/total are the sums of its lines, saved
// with them.
model Invoice {
  id              String          @id @default(cuid())
  invoiceNumber   Int             @unique @default(autoincrement()) @map("invoice_number")
  kind            InvoiceKind     @default(INITIAL)
  customerId      String          @map("customer_id")
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accountId       String?         @map("account_id")
  account         Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status          InvoiceStatus   @default(DRAFT)
  currency        BillingCurrency @default(USD)
  // 18% VAT for Israeli clients, and the PayPal fee for clients paying by
  // PayPal. Both start from the account's details and can be changed.
  applyVat        Boolean         @default(false) @map("apply_vat")
  applyPaypalFee  Boolean         @default(false) @map("apply_paypal_fee")
  otfAmount       Decimal         @map("otf_amount") @db.Decimal(10, 2)
  depositAmount   Decimal         @map("deposit_amount") @db.Decimal(10, 2)
  ndPercent       Decimal         @map("nd_percent") @db.Decimal(5, 2)
  vatPercent      Decimal         @map("vat_percent") @db.Decimal(5, 2)
  paypalPercent   Decimal         @map("paypal_percent") @db.Decimal(5, 2)
  subtotal        Decimal         @default(0) @db.Decimal(12, 2)
  vatAmount       Decimal         @default(0) @map("vat_amount") @db.Decimal(12, 2)
  paypalFeeAmount Decimal         @default(0) @map("paypal_fee_amount") @db.Decimal(12, 2)
  total           Decimal         @default(0) @db.Decimal(12, 2)
  amountPaid      Decimal         @default(0) @map("amount_paid") @db.Decimal(12, 2)
  notes           String?
  sentAt          DateTime?       @map("sent_at")
  sentByEmail     String?         @map("sent_by_email")
  voidedAt        DateTime?       @map("voided_at")
  voidedByEmail   String?         @map("voided_by_email")
  voidReason      String?         @map("void_reason")
  createdByEmail  String          @map("created_by_email")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedByEmail  String?         @map("updated_by_email")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  items       InvoiceItem[]
  departments InvoiceDepartmentFee[]
  lines       InvoiceLine[]
  payments    Payment[]

  @@index([customerId])
  @@index([status])
  @@map("invoices")
  @@schema("vaa_sys")
}

// One VA request on a bill: what the Lead Manager confirmed for it. hours and
// ndHours are per VA for the first period (prorated from the target start
// date, or the project hours), prefilled from the request and editable, e.g.
// to leave out a holiday.
model InvoiceItem {
  id                     String        @id @default(cuid())
  invoiceId              String        @map("invoice_id")
  invoice                Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  ticketRequestId        String?       @map("ticket_request_id")
  ticketRequest          TicketRequest? @relation(fields: [ticketRequestId], references: [id], onDelete: SetNull)
  lineNo                 Int           @map("line_no")
  service                String
  department             String
  scheduleType           ScheduleType  @map("schedule_type")
  numberOfVas            Int           @map("number_of_vas")
  periodStart            DateTime      @map("period_start") @db.Date
  periodEnd              DateTime?     @map("period_end") @db.Date
  hourlyRate             Decimal       @map("hourly_rate") @db.Decimal(10, 2)
  hours                  Decimal       @db.Decimal(8, 2)
  ndHours                Decimal       @default(0) @map("nd_hours") @db.Decimal(8, 2)
  // How hours was first worked out, e.g. "3 h × 11 workdays (Nov 16–30)".
  hoursBasis             String        @map("hours_basis")
  freeHours              Decimal       @default(0) @map("free_hours") @db.Decimal(6, 2)
  freeHoursRef           String?       @map("free_hours_ref")
  depositDiscountPercent Decimal       @default(0) @map("deposit_discount_percent") @db.Decimal(5, 2)
  depositApprovalRef     String?       @map("deposit_approval_ref")

  @@unique([invoiceId, lineNo])
  @@map("invoice_items")
  @@schema("vaa_sys")
}

// The One-Time Fee for one department on a bill. exempt: Creatives with only
// project-based VAs pays no OTF.
model InvoiceDepartmentFee {
  id              String  @id @default(cuid())
  invoiceId       String  @map("invoice_id")
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  department      String
  exempt          Boolean @default(false)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  approvalRef     String? @map("approval_ref")

  @@unique([invoiceId, department])
  @@map("invoice_department_fees")
  @@schema("vaa_sys")
}

// The bill's lines as the customer sees them, rewritten from its items and
// department fees on every save. A reduction (discount, free hours) also
// records what it gave up: those rows are the Foregone Revenue log.
model InvoiceLine {
  id             String          @id @default(cuid())
  invoiceId      String          @map("invoice_id")
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNo         Int             @map("line_no")
  kind           InvoiceLineKind
  description    String
  calculation    String
  amount         Decimal         @db.Decimal(12, 2)
  department     String?
  foregoneAmount Decimal         @default(0) @map("foregone_amount") @db.Decimal(12, 2)
  foregoneType   ForegoneType?   @map("foregone_type")
  approvalRef    String?         @map("approval_ref")

  @@unique([invoiceId, lineNo])
  @@index([foregoneType])
  @@map("invoice_lines")
  @@schema("vaa_sys")
}

// A payment Accounting recorded against a bill, in the bill's currency.
model Payment {
  id              String   @id @default(cuid())
  invoiceId       String   @map("invoice_id")
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId      String   @map("customer_id")
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount          Decimal  @db.Decimal(12, 2)
  paidOn          DateTime @map("paid_on") @db.Date
  method          String
  reference       String?
  notes           String?
  recordedByEmail String   @map("recorded_by_email")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([customerId])
  @@index([paidOn])
  @@map("payments")
  @@schema("vaa_sys")
}

// The default hourly rate per service, in USD, that a new bill starts from
// when the service has no Standard Billing Rate (ServiceProfile below).
model BillingRate {
  id             String   @id @default(cuid())
  service        String   @unique
  hourlyRate     Decimal  @map("hourly_rate") @db.Decimal(10, 2)
  updatedByEmail String   @map("updated_by_email")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("billing_rates")
  @@schema("vaa_sys")
}

// ── Services (Lead Management → Departments & services) ──────────

// What vaa-sys keeps about one of VAA Workforce's services (public.skills,
// by id; no foreign key, since that table is Workforce's). Its Job
// Description is Workforce's own column (skills.job_description).
//
// The two rates are confidential (Nov 5, 2026): they're stored encrypted
// (lib/rates.ts, AES-256-GCM with RATES_ENCRYPTION_KEY, which is set only in
// Vercel), so the database and developers see only ciphertext. A new initial
// bill starts from the Standard Billing Rate of the service the onboarding
// form asked for (onboardingService).
model ServiceProfile {
  skillId             String    @id @map("skill_id")
  // The onboarding form's service (SERVICE_OFFERINGS) this service bills for.
  onboardingService   String?   @unique @map("onboarding_service")
  contractId          String?   @map("contract_id")
  contract            Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  standardRateCipher  String?   @map("standard_rate_cipher")
  vaBaseRateCipher    String?   @map("va_base_rate_cipher")
  ratesUpdatedAt      DateTime? @map("rates_updated_at")
  ratesUpdatedByEmail String?   @map("rates_updated_by_email")
  updatedByEmail      String?   @map("updated_by_email")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("service_profiles")
  @@schema("vaa_sys")
}

// Who may see and set the confidential rates, besides the owner
// (operations-admin@vaaphilippines.com, in lib/rates.ts). Each row carries an
// HMAC of the email made with the rates key, so a row added straight in the
// database (without the key) doesn't count. Granted on User access.
model RateViewer {
  id             String   @id @default(cuid())
  email          String   @unique
  signature      String
  grantedByEmail String   @map("granted_by_email")
  grantedAt      DateTime @default(now()) @map("granted_at")

  @@map("rate_viewers")
  @@schema("vaa_sys")
}

// ── Settings ─────────────────────────────────────────────────────

// General settings admins edit in the app, one row per key (e.g. the work
// hour type minimums). A missing row means the app's built-in defaults.
model AppSetting {
  key            String   @id
  value          Json
  updatedByEmail String?  @map("updated_by_email")
  updatedAt      DateTime @default(now()) @map("updated_at")

  @@map("app_settings")
  @@schema("vaa_sys")
}
